# ============================================================================
# CLOUD-COST-PULSE v3.0 — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================

# Clerk Authentication Keys (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase (required for persistent database storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Legacy Mongo/PostgreSQL variables (only used when Supabase is not configured)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloud_cost_pulse
MONGO_URL=mongodb://localhost:27017
DB_NAME=cloud_cost_pulse

# Encryption Key for Client Secrets (Required for Azure/Resend encryption)
SECRET_ENCRYPTION_KEY=32_character_random_string_here_123456

# Resend Email Alerts API Key (Optional)
RESEND_API_KEY=re_123456789
